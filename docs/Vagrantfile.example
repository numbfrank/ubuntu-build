# -*- mode: ruby -*-
# vi: set ft=ruby :

# Copy this file to Vagrantfile in the repository root before running vagrant.
#
# Headless server (default): vagrant up --provider=virtualbox
# Desktop VM: UBUNTU_BUILD_MODE=desktop vagrant up --provider=virtualbox
# VMware or libvirt: use --provider=vmware_desktop or --provider=libvirt
# To use another Ubuntu 24.04 box: UBUNTU_BUILD_BOX=owner/box vagrant up
#
# Run `UBUNTU_BUILD_MODE=desktop vagrant reload` after the first desktop
# provision to start the new GUI. Pass the mode on later Vagrant commands too.

mode = ENV.fetch("UBUNTU_BUILD_MODE", "headless")
abort "UBUNTU_BUILD_MODE must be headless or desktop" unless %w[headless desktop].include?(mode)

desktop = mode == "desktop"
memory_mb = desktop ? 6144 : 4096

Vagrant.configure("2") do |config|
  config.vm.box = ENV.fetch("UBUNTU_BUILD_BOX", "bento/ubuntu-24.04")
  config.vm.hostname = "ubuntu-build"

  # NAT and the default /vagrant synced folder are sufficient for provisioning.
  # Forward an application port only when needed, for example:
  # config.vm.network "forwarded_port", guest: 3000, host: 3000

  config.vm.provider "virtualbox" do |vb|
    vb.name = "ubuntu-build-#{mode}"
    vb.memory = memory_mb
    vb.cpus = 2
    vb.gui = desktop
  end

  config.vm.provider "vmware_desktop" do |vmware|
    vmware.vmx["memsize"] = memory_mb.to_s
    vmware.vmx["numvcpus"] = "2"
    vmware.gui = desktop
  end

  config.vm.provider "libvirt" do |libvirt|
    libvirt.memory = memory_mb
    libvirt.cpus = 2
    libvirt.graphics_type = "spice" if desktop
  end

  # Run the checked-out script from /vagrant so its wallpaper asset comes
  # from the same revision. Vagrant runs shell provisioners as root.
  config.vm.provision "shell",
    inline: "bash /vagrant/setup-all.sh #{desktop ? '--desktop' : '--headless'}",
    privileged: true

  config.vm.post_up_message = <<-MSG
    Ubuntu build VM is ready (#{mode}).
    Connect with: vagrant ssh
    Development account: su - dev (initial password: dev)
    Change that password after provisioning: sudo passwd dev
    If this was the first desktop provision, run:
      UBUNTU_BUILD_MODE=desktop vagrant reload
  MSG
end
